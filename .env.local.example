NEXT_PUBLIC_SUPABASE_URL=https://kbctbavayemjmglkwkil.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_dengan_anon_public_key_dari_supabase

# PENTING: kunci ini SANGAT RAHASIA — jangan pernah pakai prefix NEXT_PUBLIC_
# karena akan otomatis ter-expose ke browser. Cuma dipakai di app/api/... (server).
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key_dari_supabase
